#!/usr/bin/env sh
# i18n-doc-sync pre-commit guard.
# Enable once per clone:
#   ln -sf ../../scripts/pre-commit .git/hooks/pre-commit
# (or copy it). Requires Node.

# Only run when Markdown is staged.
if git diff --cached --name-only | grep -q '\.md$'; then
  node scripts/check-i18n-docs.mjs || {
    echo "commit blocked: localized Markdown variants are out of sync." >&2
    exit 1
  }
fi
